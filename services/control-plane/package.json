  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/ws": "^8.18.1",
    "json-schema-to-typescript": "^15.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
