{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gemma4all.local/schemas/run.schema.json",
  "title": "Run",
  "type": "object",
  "schema_version": "1.0.0",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "task_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "runtime": {
      "$ref": "common.schema.json#/$defs/runtime"
    },
    "state": {
      "$ref": "common.schema.json#/$defs/run_state"
    },
    "attempt_index": {
      "type": "integer",
      "minimum": 1
    },
    "model_id": {
      "type": "string"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "started_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "ended_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "checkpoint_count": {
      "type": "integer",
      "minimum": 0
    },
    "handoff_payload_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "error_detail": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "runtime",
    "state",
    "attempt_index",
    "created_at",
    "checkpoint_count"
  ]
}
