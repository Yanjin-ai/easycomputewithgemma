{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gemma4all.local/schemas/events/artifact.uploaded.schema.json",
  "title": "ArtifactUploadedEventPayload",
  "type": "object",
  "schema_version": "1.0.0",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "storage_ref": {
      "type": "string"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "content_hash": {
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "storage_ref",
    "size_bytes",
    "content_hash"
  ]
}
