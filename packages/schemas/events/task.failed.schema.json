{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gemma4all.local/schemas/events/task.failed.schema.json",
  "title": "TaskFailedEventPayload",
  "type": "object",
  "schema_version": "1.0.0",
  "additionalProperties": false,
  "properties": {
    "failure_reason": {
      "type": "string"
    },
    "last_run_id": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "total_attempt_count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "failure_reason",
    "last_run_id",
    "total_attempt_count"
  ]
}
